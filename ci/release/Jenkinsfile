#! /usr/bin/groovy
@Library('hibernate-jenkins-pipeline-helpers') _

// Releases are explicit operator actions, never a consequence of branch indexing or a push.
if (!currentBuild.getBuildCauses().toString().contains('UserIdCause')) {
    currentBuild.result = 'NOT_BUILT'
    return
}

def versionParts(String value, boolean development) {
    def suffix = development ? '-SNAPSHOT' : ''
    if (!(value ==~ /(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)${suffix}/)) {
        error("Invalid ${development ? 'development' : 'release'} version: ${value}")
    }
    return value.replace('-SNAPSHOT', '').tokenize('.').collect { new BigInteger(it) }
}

def validateVersions(String branch, String current, String releaseVersion, String developmentVersion) {
    if (branch != 'main' && !(branch ==~ /(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)/)) {
        error('Release jobs must select main or a MAJOR.MINOR maintenance branch.')
    }
    def release = versionParts(releaseVersion, false)
    def next = versionParts(developmentVersion, true)
    versionParts(current, true)
    if (current != "${releaseVersion}-SNAPSHOT") {
        error("Release version must match the branch snapshot ${current}.")
    }
    def comparison = 0
    for (int i = 0; i < 3 && comparison == 0; i++) {
        comparison = next[i].compareTo(release[i])
    }
    if (comparison <= 0) {
        error('The next development version must be greater than the release version.')
    }
    if (branch != 'main' && (branch != "${release[0]}.${release[1]}" || branch != "${next[0]}.${next[1]}")) {
        error('Maintenance branch, release, and development versions must share a family.')
    }
}

def withReleaseSSH(Closure action) {
    configFileProvider([
            configFile(fileId: 'release.config.ssh', variable: 'RELEASE_SSH_CONFIG'),
            configFile(fileId: 'release.config.ssh.knownhosts', variable: 'RELEASE_SSH_KNOWN_HOSTS')]) {
        withEnv(["GIT_SSH_COMMAND=ssh -F \"${env.RELEASE_SSH_CONFIG}\" -o UserKnownHostsFile=\"${env.RELEASE_SSH_KNOWN_HOSTS}\""]) {
            sshagent(['ed25519.Hibernate-CI.github.com']) { action() }
        }
    }
}

pipeline {
    agent { label 'Release' }
    tools { jdk 'OpenJDK 25 Latest' }
    options {
        skipDefaultCheckout()
        disableConcurrentBuilds(abortPrevious: false)
        lock(resource: 'hibernate-migration-recipes-release')
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '10'))
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
    }
    parameters {
        string(name: 'RELEASE_VERSION', defaultValue: '', trim: true,
                description: 'Required stable version, e.g. 1.0.0; must match this branch’s current snapshot.')
        string(name: 'DEVELOPMENT_VERSION', defaultValue: '', trim: true,
                description: 'Required next development version, e.g. 1.0.1-SNAPSHOT.')
        booleanParam(name: 'RELEASE_DRY_RUN', defaultValue: true,
                description: 'Verify and stage locally; do not push, upload, or publish anything.')
    }
    environment {
        PROJECT = 'migration-recipes'
        DISABLE_REMOTE_GRADLE_CACHE = 'true'
    }
    stages {
        stage('Validate') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def branch = env.BRANCH_NAME ?: ''
                    if (branch != 'main' && !(branch ==~ /(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)/)) {
                        error('Release jobs must select main or a MAJOR.MINOR maintenance branch.')
                    }
                    env.RELEASE_BRANCH = branch
                    env.RELEASE_VERSION = params.RELEASE_VERSION
                    env.DEVELOPMENT_VERSION = params.DEVELOPMENT_VERSION
                    env.JRELEASER_DRY_RUN = params.RELEASE_DRY_RUN.toString()
                    withReleaseSSH {
                        sh '''#!/usr/bin/env bash
set -euo pipefail
git remote set-url origin git@github.com:hibernate/hibernate-migration-recipes.git
git fetch origin "$RELEASE_BRANCH" --tags
git checkout -B "$RELEASE_BRANCH" FETCH_HEAD
test -z "$(git status --porcelain)"
if test -n "$(git ls-remote --tags origin "refs/tags/$RELEASE_VERSION")"; then
    echo 'Release tag already exists'; exit 1
fi
'''
                    }
                    def current = readFile('version.txt').trim()
                    validateVersions(branch, current, params.RELEASE_VERSION, params.DEVELOPMENT_VERSION)
                    env.SOURCE_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    dir('.release/scripts') {
                        checkout scmGit(branches: [[name: '*/main']], extensions: [],
                                userRemoteConfigs: [[credentialsId: 'ed25519.Hibernate-CI.github.com',
                                        url: 'https://github.com/hibernate/hibernate-release-scripts.git']])
                        env.RELEASE_SCRIPTS_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    }
                    // Fail before preparation until the separate shared-script integration is available.
                    if (sh(script: '.release/scripts/determine-current-project-groupid.sh migration-recipes',
                            returnStdout: true).trim() != 'org.hibernate.migration') {
                        error('Shared release scripts do not support this project’s Maven group.')
                    }
                    if (sh(script: '.release/scripts/determine-current-version.sh migration-recipes',
                            returnStdout: true).trim() != current) {
                        error('Shared release scripts must read this project’s version.txt.')
                    }
                    // Resolve all required credentials before creating release commits.
                    withCredentials([
                            usernamePassword(credentialsId: 'central.sonatype.com',
                                    usernameVariable: 'JRELEASER_MAVENCENTRAL_USERNAME', passwordVariable: 'JRELEASER_MAVENCENTRAL_TOKEN'),
                            file(credentialsId: 'release.gpg.private-key', variable: 'RELEASE_GPG_PRIVATE_KEY_PATH'),
                            string(credentialsId: 'release.gpg.passphrase', variable: 'JRELEASER_GPG_PASSPHRASE'),
                            string(credentialsId: 'Hibernate-CI.github.com', variable: 'JRELEASER_GITHUB_TOKEN')]) {
                        echo 'Publishing credentials are available.'
                    }
                }
            }
        }
        stage('Prepare') {
            steps {
                withReleaseSSH {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
options=()
if test "$JRELEASER_DRY_RUN" = true; then options+=(-d); fi
.release/scripts/prepare-release.sh -j "${options[@]}" -b "$RELEASE_BRANCH" \
    -v "$DEVELOPMENT_VERSION" "$PROJECT" "$RELEASE_VERSION"
test "$(cat version.txt)" = "$RELEASE_VERSION"
test -z "$(git status --porcelain)"
git rev-parse HEAD > .release/release-commit.txt
git rev-parse HEAD^ > .release/source-commit.txt
test "$(cat .release/source-commit.txt)" = "$SOURCE_COMMIT"
'''
                }
            }
        }
        stage('Verify and stage') {
            steps {
                sh './gradlew conversionTestOrm80 --daemon --stacktrace'
                sh './gradlew build releasePrepare --daemon --stacktrace -x conversionTestOrm80'
                sh '''#!/usr/bin/env bash
set -euo pipefail
test -z "$(git status --porcelain)"
test "$(git rev-parse HEAD)" = "$(cat .release/release-commit.txt)"
{
    echo "branch=$RELEASE_BRANCH"
    echo "releaseVersion=$RELEASE_VERSION"
    echo "developmentVersion=$DEVELOPMENT_VERSION"
    echo "sourceCommit=$(cat .release/source-commit.txt)"
    echo "releaseCommit=$(cat .release/release-commit.txt)"
    echo "scriptsCommit=$RELEASE_SCRIPTS_COMMIT"
    echo "dryRun=$JRELEASER_DRY_RUN"
    find build/staging-deploy/maven -type f -exec sha256sum {} \\;
} > .release/manifest.txt
'''
                archiveArtifacts artifacts: 'build/staging-deploy/maven/**/*,.release/manifest.txt', fingerprint: true
            }
        }
        stage('Publish') {
            steps {
                withCredentials([
                        usernamePassword(credentialsId: 'central.sonatype.com',
                                usernameVariable: 'JRELEASER_MAVENCENTRAL_USERNAME', passwordVariable: 'JRELEASER_MAVENCENTRAL_TOKEN'),
                        file(credentialsId: 'release.gpg.private-key', variable: 'RELEASE_GPG_PRIVATE_KEY_PATH'),
                        string(credentialsId: 'release.gpg.passphrase', variable: 'JRELEASER_GPG_PASSPHRASE'),
                        string(credentialsId: 'Hibernate-CI.github.com', variable: 'JRELEASER_GITHUB_TOKEN')]) {
                    withReleaseSSH {
                        sh '''#!/usr/bin/env bash
set -euo pipefail
options=()
if test "$JRELEASER_DRY_RUN" = true; then options+=(-d); fi
printf 'Migration recipes and usage documentation: https://github.com/hibernate/hibernate-migration-recipes/blob/%s/README.adoc\n' \
    "$RELEASE_VERSION" > .release/release-notes.md
.release/scripts/publish.sh -j "${options[@]}" --notes=.release/release-notes.md \
    "$PROJECT" "$RELEASE_VERSION" "$DEVELOPMENT_VERSION" "$RELEASE_BRANCH"
'''
                    }
                }
                script {
                    currentBuild.description = "${env.RELEASE_BRANCH}: ${params.RELEASE_VERSION}${params.RELEASE_DRY_RUN ? ' (dry run)' : ''}"
                    echo "${params.RELEASE_DRY_RUN ? 'Dry run completed' : 'Released'} org.hibernate.migration:hibernate-migration-recipes:${params.RELEASE_VERSION}"
                }
            }
        }
    }
    post {
        always {
            junit testResults: 'build/test-results/**/*.xml,buildSrc/build/test-results/**/*.xml', allowEmptyResults: true
            // Extract only the deployment identifier; raw JReleaser traces may contain credentials.
            sh '''#!/usr/bin/env bash
set -euo pipefail
if test -f out/jreleaser/trace.log; then
    awk '/Bundle .* uploaded as deployment / { print $NF }' out/jreleaser/trace.log > .release/deployment-id.txt
fi
'''
            archiveArtifacts artifacts: '.release/manifest.txt,.release/deployment-id.txt,build/reports/tests/**/*,buildSrc/build/reports/tests/**/*', allowEmptyArchive: true
        }
        success {
            script {
                if (!params.RELEASE_DRY_RUN) {
                    echo "GitHub release: https://github.com/hibernate/hibernate-migration-recipes/releases/tag/${params.RELEASE_VERSION}"
                }
            }
        }
    }
}
